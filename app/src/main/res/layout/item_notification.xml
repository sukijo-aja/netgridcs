<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:padding="4dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_green"
    android:backgroundTint="#F0FDF4"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_notifications"
        app:tint="@color/primary_green"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="#D1FAE5"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        android:layout_gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Promo Khusus!"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Dapatkan diskon 50% untuk langganan hari ini."
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary" />
            
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2 jam yang lalu"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:textColor="#9CA3AF" />

        <TextView
            android:id="@+id/tvMessageId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="ID: 0:1629..."
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:textColor="#D1D5DB" />
    </LinearLayout>
    
    <View
        android:id="@+id/vUnreadIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_circle_icon"
        android:backgroundTint="#EF4444"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:visibility="visible" />

</LinearLayout>
