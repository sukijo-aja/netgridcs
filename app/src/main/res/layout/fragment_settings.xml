<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <include
        android:id="@+id/appBarLayout"
        layout="@layout/layout_app_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <!-- ACCOUNT SECTION -->
            <TextView
                style="@style/SettingsHeader"
                android:text="@string/account" />

            <TextView
                android:id="@+id/tvUserId"
                style="@style/SettingsItem"
                android:text="@string/user_id_label"
                android:textColor="@color/text_secondary"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/btnLogin"
                style="@style/SettingsItem"
                android:text="@string/login"
                android:drawableStart="@android:drawable/ic_secure"
                />

            <TextView
                android:id="@+id/btnEditProfile"
                style="@style/SettingsItem"
                android:text="@string/edit_profile"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/btnChangePassword"
                style="@style/SettingsItem"
                android:text="@string/change_password"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/btnDeleteAccount"
                style="@style/SettingsItem"
                android:text="@string/delete_account"
                android:textColor="@color/design_default_color_error"
                android:drawableStart="@android:drawable/ic_menu_delete"
                android:drawableTint="@color/design_default_color_error"
                android:visibility="gone"
                />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp" />

            <!-- GENERAL SECTION -->
            <TextView
                style="@style/SettingsHeader"
                android:text="@string/general" />

            <TextView
                android:id="@+id/btnLanguage"
                style="@style/SettingsItem"
                android:text="@string/language"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNotifications"
                style="@style/SettingsSwitch"
                android:text="@string/push_notifications"
                android:drawableStart="@drawable/ic_notifications"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                style="@style/SettingsSwitch"
                android:text="@string/dark_mode"
                android:drawableStart="@android:drawable/ic_menu_view"
                />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPremium"
                style="@style/SettingsSwitch"
                android:text="@string/simulate_premium"
                android:drawableStart="@android:drawable/btn_star"
                android:visibility="gone"
                />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp" />

            <!-- ABOUT & SUPPORT SECTION -->
            <TextView
                style="@style/SettingsHeader"
                android:text="@string/about_support" />

            <TextView
                android:id="@+id/btnFaqHelp"
                style="@style/SettingsItem"
                android:text="@string/faq_help"
                android:drawableStart="@android:drawable/ic_dialog_info"
                />

            <TextView
                android:id="@+id/btnClearCache"
                style="@style/SettingsItem"
                android:text="@string/clear_cache"
                android:drawableStart="@android:drawable/ic_menu_delete"
                />

            <TextView
                android:id="@+id/btnRateUs"
                style="@style/SettingsItem"
                android:text="@string/rate_us"
                android:drawableStart="@android:drawable/btn_star"
                />

            <TextView
                android:id="@+id/btnShareApp"
                style="@style/SettingsItem"
                android:text="@string/share_app"
                android:drawableStart="@android:drawable/ic_menu_share"
                />

            <TextView
                android:id="@+id/btnContactUs"
                style="@style/SettingsItem"
                android:text="@string/contact_us"
                android:drawableStart="@android:drawable/ic_dialog_email"
                />

            <TextView
                android:id="@+id/btnTermsOfService"
                style="@style/SettingsItem"
                android:text="@string/terms_of_service"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                />

            <TextView
                android:id="@+id/btnPrivacyPolicy"
                style="@style/SettingsItem"
                android:text="@string/privacy_policy"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                />

            <!-- APP VERSION -->
            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                />

        </LinearLayout>

    </ScrollView>
</LinearLayout>
