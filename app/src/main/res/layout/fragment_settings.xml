<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="User ID: ..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchReminder"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="Enable Prayer Alarms"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPreReminderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminder before Adhan: 0 min"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekBarPreReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="0"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnManagePrayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_prayer_alarms"
            android:backgroundTint="@color/primary_green"
            android:textColor="@android:color/white"
            android:drawableEnd="@android:drawable/ic_menu_edit"
            android:drawableTint="@android:color/white"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"/>

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language"
            android:backgroundTint="@color/primary_green"
            android:textColor="@android:color/white"
            android:drawableEnd="@android:drawable/ic_menu_sort_by_size"
            android:drawableTint="@android:color/white"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"/>

        <TextView
            android:id="@+id/labelFontSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_font_size"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBarFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="6"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preview"
            android:layout_marginBottom="4dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp">
            <TextView
                android:id="@+id/tvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"
                android:textSize="24sp"
                android:padding="16dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPremium"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="Simulate Premium User (No Ads)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginVertical="16dp" />

        <Button
            android:id="@+id/btnResetData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Data (Test Online)"
            android:backgroundTint="@color/design_default_color_error"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnDownloadAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download All Resources (Offline)"
            android:backgroundTint="@color/primary_green"
            android:textColor="@android:color/white"
            android:drawableEnd="@android:drawable/stat_sys_download"
            android:drawableTint="@android:color/white"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"/>


    </LinearLayout>

</ScrollView>
