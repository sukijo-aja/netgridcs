<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_bottom_sheet_bg"> <!-- Background can be just color if drawable doesn't exist, but standard material handles it -->

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manage_prayer_alarms"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Main Reminder Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/bsSwitchReminder"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="@string/enable_prayer_alarms"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Pre-Reminder SeekBar -->
    <TextView
        android:id="@+id/bsTvPreReminderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reminder_before_adhan_minutes"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/bsSeekBarPreReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="30"
        android:progress="0"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPrayerSettings"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="8dp"
        tools:listitem="@layout/item_prayer_setting"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Auto Silent Mode Section -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_silent_mode"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_silent_mode_desc"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/bsSwitchAutoSilent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_silent_mode" />

        <TextView
            android:id="@+id/tvSilentDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 min"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnTestNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Notification"
        android:textColor="@color/primary_green_dark"
        android:backgroundTint="@android:color/transparent"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnTestWorker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Background Update Worker"
        android:textColor="@color/primary_green_dark"
        android:backgroundTint="@android:color/transparent"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        />

    <Button
        android:id="@+id/btnCloseSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary_green_dark"/>

</LinearLayout>
