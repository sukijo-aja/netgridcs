<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <layer-list>
            <!-- Sembunyikan garis atas, kiri, dan kanan di luar batas -->
            <item
                android:left="-2dp"
                android:right="-2dp"
                android:top="-2dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <!-- Garis bawah abu-abu tipis (semitransparan agar cocok di mode gelap/terang) -->
                    <stroke
                        android:width="1dp"
                        android:color="#1F888888" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
