<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Crescent Moon -->
    <path
        android:pathData="M100,20a80,80 0,1 0,0 160a100,100 0,0 1,0 -160z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="100"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD700" /> <!-- Gold -->
                <item android:offset="0.5" android:color="#FFF9C4" /> <!-- Light Shine -->
                <item android:offset="1.0" android:color="#DAA520" /> <!-- GoldenRod -->
            </gradient>
        </aapt:attr>
    </path>


    <!-- Star -->
    <path
        android:pathData="M160,50l5,15l15,5l-15,5l-5,15l-5,-15l-15,-5l15,-5z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="140"
                android:startY="50"
                android:endX="180"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF9C4" />
                <item android:offset="1.0" android:color="#DAA520" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
